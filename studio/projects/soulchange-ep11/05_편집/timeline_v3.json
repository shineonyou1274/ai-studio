 "subs": [
  [
   1.3,
   4.58,
   "좋아. 오늘은 하은이 상담만 제대로 하자."
  ],
  [
   11.75,
   16.92,
   "아니... 이런 걸 하루에 다 하라고? 도대체 수업할 시간이 있긴 한 거야?"
  ],
  [
   22.57,
   25.23,
   "...그래서 내가 맨날 과자로 버텼지."
  ],
  [
   25.87,
   30.04,
   "너 이렇게 될 줄 몰랐어? 언젠가는 다 들통날 수 있는 일이었어."
  ],
  [
   30.49,
   35.73,
   "네가 병결로 처리되더라도, 너는 거짓말쟁이라고 계속 꼬리표가 따라다닐 거야."
  ],
  [
   36.18,
   41.24,
   "...근데 이렇게 말해도 되나? 한마디 잘못하면 정서학대라던데."
  ],
  [
   42.04,
   44.94,
   "에이, 내가 이런 말 할 자격이 있나."
  ],
  [
   46.99,
   50.4,
   "...선생님, 죄송합니다. 다시 이런 일 없을게요."
  ],
  [
   51.29,
   53.57,
   "엄마는... 제가 알아서 할게요."
  ],
  [
   53.87,
   57.9,
   "...나도 그랬어. 아, 아니, 선생님도... 그런 적 있어."
  ],
  [
   61.77,
   63.75,
   "...엄마가, 온다고?"
  ]
 ],
