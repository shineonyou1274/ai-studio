 "subs": [
  [
   2.0,
   4.7,
   "...엄마 앞에서 담임인 척이라니."
  ],
  [
   5.9,
   8.81,
   "선생님, 요즘 애가 방에서 잘 나오지도 않고요,"
  ],
  [
   8.84,
   11.74,
   "제가 옆에 가기만 해도 질색을 하질 않나..."
  ],
  [
   11.77,
   15.72,
   "계속 눈을 찡그리고 머리를 긁으면서 한숨 쉬고 씩씩거리고,"
  ],
  [
   15.75,
   20.55,
   "다리를 쩍쩍 아무 데서나 막 벌리고 있길래 한 소리 했더니,"
  ],
  [
   20.58,
   23.27,
   "그 뒤로 밥도 같이 안 먹으려고 하더라고요."
  ],
  [
   23.3,
   26.87,
   "학교는 또 새벽같이 나가서 얼굴 보기도 힘들고요."
  ],
  [
   27.57,
   29.85,
   "사실 애가 너무 힘들어하길래, 제가 하루 학교 쉬라며"
  ],
  [
   29.88,
   32.32,
   "생결 확인서를 써 줬거든요."
  ],
  [
   32.35,
   33.8,
   "죄송합니다, 선생님."
  ],
  [
   33.83,
   37.43,
   "그러면 안 된다는 걸 알면서 딱 한 번만... 하면서 써 줬는데,"
  ],
  [
   37.46,
   40.9,
   "저도 그렇고 우리 지우도 그게 너무 죄책감이 들어서"
  ],
  [
   40.93,
   44.03,
   "마음이 계속 힘드네요."
  ],
  [
   44.06,
   47.39,
   "엄마, 그만... 내가 잘못했어."
  ],
  [
   47.44,
   50.63,
   "엄마, 내가... 내가 부탁한 거잖아."
  ],
  [
   50.66,
   52.39,
   "다 내가 잘못한 거야."
  ],
  [
   52.42,
   55.48,
   "나 그날 학교 째고 PC방도 갔어."
  ],
  [
   55.98,
   57.74,
   "...지우...니?"
  ],
  [
   58.04,
   62.25,
   "그냥 나도 몰라, 왜 그랬는지... 아프고 싶었어."
  ],
  [
   62.28,
   65.58,
   "뭘 정해야 할 때마다 무서워서, 게임하면 잊혀서."
  ],
  [
   65.61,
   68.28,
   "다들 그러니까 괜찮은 줄 알았어."
  ],
  [
   68.73,
   72.51,
   "마약도 도박도 아닌데 이 정도면 정상이라고..."
  ],
  [
   72.54,
   75.82,
   "근데 그냥, 비겁했던 거야. 미안해, 엄마."
  ],
  [
   79.56,
   82.98,
   "...엄마, 나 이제 힘들면 힘들다고 말하고,"
  ],
  [
   83.01,
   85.86,
   "뭐든 피하지 않고 씩씩하게 해 볼게."
  ],
  [
   89.31,
   90.65,
   "참 내... 하."
  ],
  [
   92.21,
   94.17,
   "샘이 뭔데 그러세요?"
  ],
  [
   94.51,
   97.66,
   "그래. 나 암것도 아니야. 아무 힘도 없어."
  ],
  [
   97.69,
   99.47,
   "그런데 너가 가여워서 그래."
  ],
  [
   99.5,
   100.84,
   "너 지금 나 아니면,"
  ],
  [
   100.88,
   105.12,
   "너한테 그렇게 살지 말라고 말해 줄 사람을 앞으로 못 만날까 봐 그래."
  ],
  [
   105.42,
   108.79,
   "한 번쯤 제대로 네 삶에 참견하는 사람이 있어도 괜찮지 않을까."
  ],
  [
   108.82,
   111.05,
   "하지만 너가 원하지 않으면, 하지 않을 거야."
  ],
  [
   111.08,
   115.21,
   "내가 하는 잔소리들은 아주 귀해서, 아무에게나 나눠 주는 건 아니거든."
  ],
  [
   115.24,
   118.01,
   "...자. 선택해라. 어떻게 할래?"
  ],
  [
   121.21,
   124.13,
   "아얏! 거, 똑바로 좀 보고 다녀요!"
  ],
  [
   124.88,
   127.48,
   "교감샘도 저처럼 살아 봐라."
  ],
  [
   128.63,
   132.13,
   "서로 돼 보는 게 소원이야? ...접수했어."
  ]
 ],
