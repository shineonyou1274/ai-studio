 "subs": [
  [
   2.0,
   4.7,
   "...엄마 앞에서 담임인 척이라니."
  ],
  [
   5.9,
   8.81,
   "선생님, 요즘 애가 방에서 잘 나오지도 않고요,"
  ],
  [
   8.84,
   11.74,
   "제가 옆에 가기만 해도 질색을 하질 않나..."
  ],
  [
   11.77,
   15.72,
   "계속 눈을 찡그리고 머리를 긁으면서 한숨 쉬고 씩씩거리고,"
  ],
  [
   15.75,
   20.55,
   "다리를 쩍쩍 아무 데서나 막 벌리고 있길래 한 소리 했더니,"
  ],
  [
   20.58,
   23.27,
   "그 뒤로 밥도 같이 안 먹으려고 하더라고요."
  ],
  [
   23.3,
   26.87,
   "학교는 또 새벽같이 나가서 얼굴 보기도 힘들고요."
  ],
  [
   27.57,
   29.75,
   "사실 애가 너무 힘들어하길래, 제가 하루 학교 쉬라며"
  ],
  [
   29.78,
   32.14,
   "생결 확인서를 써 줬거든요."
  ],
  [
   32.17,
   33.67,
   "죄송합니다, 선생님."
  ],
  [
   33.7,
   37.25,
   "그러면 안 된다는 걸 알면서 딱 한 번만... 하면서 써 줬는데,"
  ],
  [
   37.28,
   40.66,
   "저도 그렇고 우리 지우도 그게 너무 죄책감이 들어서"
  ],
  [
   40.69,
   43.56,
   "마음이 계속 힘드네요."
  ],
  [
   43.59,
   44.59,
   "죄..."
  ],
  [
   44.62,
   47.95,
   "엄마, 그만... 내가 잘못했어."
  ],
  [
   47.99,
   51.18,
   "엄마, 내가... 내가 부탁한 거잖아."
  ],
  [
   51.21,
   52.95,
   "다 내가 잘못한 거야."
  ],
  [
   52.98,
   56.03,
   "나 그날 학교 째고 PC방도 갔어."
  ],
  [
   56.53,
   58.29,
   "...지우...니?"
  ],
  [
   58.59,
   62.8,
   "그냥 나도 몰라, 왜 그랬는지... 아프고 싶었어."
  ],
  [
   62.83,
   66.13,
   "뭘 정해야 할 때마다 무서워서, 게임하면 잊혀서."
  ],
  [
   66.16,
   68.84,
   "다들 그러니까 괜찮은 줄 알았어."
  ],
  [
   69.28,
   73.07,
   "마약도 도박도 아닌데 이 정도면 정상이라고..."
  ],
  [
   73.1,
   76.37,
   "근데 그냥, 비겁했던 거야. 미안해, 엄마."
  ],
  [
   81.12,
   84.53,
   "...엄마, 나 이제 힘들면 힘들다고 말하고,"
  ],
  [
   84.56,
   87.41,
