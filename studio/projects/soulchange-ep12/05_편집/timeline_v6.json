  ],
  [
   93.76,
   95.72,
   "샘이 뭔데 그러세요?"
  ],
  [
   96.06,
   99.22,
   "그래. 나 암것도 아니야. 아무 힘도 없어."
  ],
  [
   99.25,
   101.02,
   "그런데 너가 가여워서 그래."
  ],
  [
   101.05,
   102.4,
   "너 지금 나 아니면,"
  ],
  [
   102.43,
   106.67,
   "너한테 그렇게 살지 말라고 말해 줄 사람을 앞으로 못 만날까 봐 그래."
  ],
  [
   106.97,
   110.34,
