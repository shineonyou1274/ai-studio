  [
   1.15,
   7.02,
   "자, 오늘 모의고사고... 그래서... 아무튼... 파이팅..."
  ],
  [
   4.9,
   6.45,
   "...담임 왜 저러냐?"
  ],
  [
   6.48,
   9.26,
   "...말투 완전 우리 같아."
  ],
  [
   8.4,
   11.94,
   "얘들아, 샘 이야기하시잖아. 조용히 해."
  ],
  [
   11.97,
   14.55,
   "...너 요즘 진짜 이상해."
  ],
  [
   16.15,
   19.63,
   "쌤... 저 생조 쓸래요."
  ],
  [
   19.68,
   24.58,
   "그래? 흠... 어머니한테 확인 전화할 거야."
  ],
  [
   25.38,
   27.72,
   "네~ 엄마예요~"
  ],
  [
   27.89,
   31.64,
   "어머니, 지난번에 다리 다치신 건 다 나으셨어요?"
  ],
  [
   32.37,
   36.95,
   "네? 아... 네. 덕분에 나았습니다. 그럼 바빠서 이만 끊습니다."
  ],
  [
   37.4,
   40.03,
   "...어머님, 다리 다치신 적 없으시지?"
  ],
  [
   41.78,
   43.76,
   "...저걸 저렇게 잡네."
  ],
  [
   53.98,
   60.05,
   "현석아, 선생님이랑 잠깐 얘기할 수 있어? ...오늘은 괜찮아?"
  ],
  [
   60.08,
   64.35,
   "선생님은 네가 힘들어하는 냄새가 있는 줄 몰랐어."
  ],
  [
   64.38,
   69.49,
   "미리 알았다면, 절대 그렇게 두지 않았을 거야. 미안해."
  ],
  [
   73.09,
   75.19,
   "...시간은 딱 오늘까지요."
  ],
  [
   75.49,
   80.06,
   "그런데 말이야. 그렇다고 해서, 선생님한테 욕을 쓰고"
  ],
  [
   80.09,
   83.74,
   "텀블러에 침을 뱉은 일이 괜찮아지는 건 아니야."
  ],
  [
   83.99,
   88.96,
   "그건 분명히 잘못한 거야. 그래도 선생님은 너한테 기회를 주고 싶어."
  ],
  [
   88.99,
   93.94,
